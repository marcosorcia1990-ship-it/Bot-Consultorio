# Variables del servicio bot-consultorio-demo (Render → Environment).
# Este archivo NO lleva secretos: los valores entre <> se llenan en Render, nunca aquí.
# Ninguna credencial ni calendario de producción debe usarse en la demo.

# --- Candados del modo demo (obligatorios) ---
MODO_DEMO=true
DEMO_DESTINATARIOS=<52 + 10 dígitos del teléfono "Paciente demo">,<52 + 10 dígitos del teléfono "Equipo">
CALENDARIOS_PROHIBIDOS=internista.marco@gmail.com
RECORDATORIOS_ACTIVOS=false

# --- Meta (número de prueba) ---
PHONE_NUMBER_ID=1502573929596107
WABA_ID=1472438634813201
WHATSAPP_TOKEN=<token temporal de "Configuración de la API" del día de la prueba>
VERIFY_TOKEN=<palabra nueva, distinta de la de producción>
GRAPH_VERSION=v25.0

# --- Panel de administración ---
ADMIN_TOKEN=<contraseña larga solo para la demo>
# PUBLIC_URL no hace falta en Render (usa RENDER_EXTERNAL_URL automáticamente)

# --- OpenAI (clave propia de la demo) ---
OPENAI_API_KEY=<clave "demo-meta">

# --- Google (cuenta de servicio bot-demo y calendarios de demo) ---
GOOGLE_CREDENTIALS_JSON=<contenido del JSON de bot-demo>
AGENDA_ACTIVA=true
CALENDAR_ID=<id>@group.calendar.google.com
CALENDARS_BUSY=<el mismo id>@group.calendar.google.com
# Puede ser el MISMO calendario de demo: los registros de estado no cuentan como citas ni ocupan horario
ESTADO_CALENDAR_ID=<el mismo id>@group.calendar.google.com

# --- Equipo ---
INTERNAL_ALERT_NUMBER=<52 + 10 dígitos del teléfono "Equipo">
PERSONAL_NUMBERS=<10 dígitos del teléfono "Equipo">

# --- Privacidad ---
LOG_SALT=<cadena aleatoria larga>
# No definir: PERMITIR_DATOS_SENSIBLES_IA, RESENAS_ACTIVAS, BOT_PAUSADO

# --- Embedded Signup (solo para la evidencia de whatsapp_business_management) ---
META_APP_ID=2779152412484703
META_APP_SECRET=<clave secreta de la app>
META_CONFIG_ID=<ID de la configuración v4 de Facebook Login for Business>
ALTA_MODO=coexistencia
